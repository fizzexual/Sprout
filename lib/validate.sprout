~ Pure declarative validation. This module neither changes caller values nor performs I/O.

private task field(record, name, fallback):
    when contains(record, name):
        give record[name]
    give fallback

private task segment(name):
    when length(name) > 128:
        give "<field name exceeds 128 characters>"
    give name

private task problem(path, message):
    give {path: path, message: message}

private task finite_number(value):
    when kind_of(value) != "number" or is_a(value, "number"):
        give no
    try:
        give value - value == 0
    caught issue:
        when issue.kind == "math":
            give no
        fail issue

private task bound(value, ceiling):
    when matches_kind(value, "integer"):
        give value >= 0 and value <= ceiling
    when not finite_number(value):
        give no
    give value >= 0 and value <= ceiling and value % 1 == 0

private task matches_kind(value, kind):
    when kind_of(value) != kind or is_a(value, kind):
        give no
    when kind == "number":
        give finite_number(value)
    give yes

private task schema_problem(schema, path, depth, budget, field_node):
    when depth > 16:
        give problem(path, "Schema nesting exceeds 16 levels; recursive schemas are not supported.")
    set budget.nodes += 1
    when budget.nodes > 1024:
        give problem(path, "Schema exceeds 1024 nodes.")
    when not matches_kind(schema, "map"):
        give problem(path, "A schema node must be a map.")
    when length(schema) > 9:
        give problem(path, "A schema node has too many options.")
    make kind = field(schema, "kind", nothing)
    when kind_of(kind) != "text" or not contains(["text", "yes-no", "list", "map", "number", "integer", "decimal"], kind):
        give problem(path + ["kind"], "Kind must be text, yes-no, list, map, number, integer or decimal.")
    for each name in keys(schema):
        make accepted = contains(["kind", "required", "nullable"], name)
        when kind == "text" or kind == "list":
            set accepted = accepted or contains(["min_length", "max_length"], name)
        when kind == "list":
            set accepted = accepted or name == "items"
        orwhen kind == "map":
            set accepted = accepted or contains(["fields", "allow_unknown"], name)
        otherwise:
            set accepted = accepted or name == "allowed"
        when not accepted:
            give problem(path + [segment(name)], "This option is not supported for this kind.")
    when contains(schema, "required") and not field_node:
        give problem(path + ["required"], "Required is only valid on a declared map field.")
    when not matches_kind(field(schema, "required", yes), "yes-no"):
        give problem(path + ["required"], "Required must be yes or no.")
    make nullable = field(schema, "nullable", no)
    when not matches_kind(nullable, "yes-no"):
        give problem(path + ["nullable"], "Nullable must be yes or no.")
    when kind == "text" or kind == "list":
        make ceiling = 1048576
        when kind == "list":
            set ceiling = 10000
        make minimum = field(schema, "min_length", 0)
        make maximum = field(schema, "max_length", ceiling)
        when not bound(minimum, ceiling):
            give problem(path + ["min_length"], "Length bounds must be whole nonnegative numbers within the documented kind limit.")
        when not bound(maximum, ceiling):
            give problem(path + ["max_length"], "Length bounds must be whole nonnegative numbers within the documented kind limit.")
        when minimum > maximum:
            give problem(path + ["min_length"], "Minimum length must not exceed maximum length.")
    when contains(schema, "allowed"):
        make allowed = schema.allowed
        when not matches_kind(allowed, "list") or length(allowed) < 1 or length(allowed) > 256:
            give problem(path + ["allowed"], "Allowed must contain from 1 to 256 scalar values.")
        set budget.allowed += length(allowed)
        when budget.allowed > 4096:
            give problem(path + ["allowed"], "Schema exceeds 4096 allowed-value entries.")
        make index = 0
        for each value in allowed:
            when is_a(value, kind_of(value)):
                give problem(path + ["allowed", index], "Allowed values must have the declared scalar kind.")
            orwhen kind_of(value) == "nothing":
                when not nullable:
                    give problem(path + ["allowed", index], "An allowed nothing value requires nullable: yes.")
            orwhen not matches_kind(value, kind):
                give problem(path + ["allowed", index], "Allowed values must have the declared scalar kind.")
            when kind_of(value) == "text":
                set budget.text += length(value)
                when budget.text > 16384:
                    give problem(path + ["allowed", index], "Schema names and allowed text exceed 16384 characters in total.")
            set index += 1
    when kind == "map":
        when not matches_kind(field(schema, "allow_unknown", no), "yes-no"):
            give problem(path + ["allow_unknown"], "Allow_unknown must be yes or no.")
        make fields = field(schema, "fields", {})
        when not matches_kind(fields, "map") or length(fields) > 128:
            give problem(path + ["fields"], "Fields must be a map with at most 128 declared fields.")
        for each name in keys(fields):
            when length(name) < 1 or length(name) > 128:
                give problem(path + ["fields", segment(name)], "Field names must contain from 1 to 128 characters.")
            set budget.text += length(name)
            when budget.text > 16384:
                give problem(path + ["fields", name], "Schema names and allowed text exceed 16384 characters in total.")
            make child = schema_problem(fields[name], path + ["fields", name], depth + 1, budget, yes)
            when child != nothing:
                give child
    orwhen kind == "list":
        when not contains(schema, "items"):
            give problem(path + ["items"], "A list schema requires an items schema.")
        give schema_problem(schema.items, path + ["items"], depth + 1, budget, no)
    give nothing

private task error(result, path, code, message):
    when length(result.errors) < 64:
        add(result.errors, {path: path, code: code, message: message})
    otherwise:
        set result.truncated = yes

private task visit(value, schema, path, depth, result):
    when result.truncated:
        give nothing
    when depth > 16 or result.nodes >= 10000:
        error(result, path, "limit", "Validation exceeds its nesting or visited-value limit.")
        set result.truncated = yes
        give nothing
    set result.nodes += 1
    when is_a(value, kind_of(value)):
        error(result, path, "kind", "Expected " + schema.kind + ".")
        give nothing
    when kind_of(value) == "nothing":
        when not field(schema, "nullable", no):
            error(result, path, "null", "Nothing is not allowed here.")
        orwhen contains(schema, "allowed") and not contains(schema.allowed, nothing):
            error(result, path, "allowed", "Value is not among the allowed values.")
        give nothing
    make kind = schema.kind
    when not matches_kind(value, kind):
        error(result, path, "kind", "Expected " + kind + ".")
        give nothing
    when contains(schema, "allowed") and not contains(schema.allowed, value):
        error(result, path, "allowed", "Value is not among the allowed values.")
    when kind == "text" or kind == "list":
        make size = length(value)
        make ceiling = 1048576
        when kind == "list":
            set ceiling = 10000
        when size > ceiling:
            error(result, path, "limit", "Value exceeds the documented text or list length limit.")
            give nothing
        when size < field(schema, "min_length", 0):
            error(result, path, "min_length", "Value is shorter than its minimum length.")
        when size > field(schema, "max_length", ceiling):
            error(result, path, "max_length", "Value is longer than its maximum length.")
    when kind == "map":
        when length(value) > 128:
            error(result, path, "limit", "A validated map may contain at most 128 fields.")
            give nothing
        make fields = field(schema, "fields", {})
        for each name in keys(fields):
            when result.truncated:
                give nothing
            when not contains(value, name):
                when field(fields[name], "required", yes):
                    error(result, path + [name], "required", "Required field is missing.")
            otherwise:
                visit(value[name], fields[name], path + [name], depth + 1, result)
        when not field(schema, "allow_unknown", no):
            for each name in keys(value):
                when result.truncated:
                    give nothing
                when not contains(fields, name):
                    error(result, path + [segment(name)], "unknown", "Field is not declared by the schema.")
    orwhen kind == "list":
        make index = 0
        repeat while index < length(value) and not result.truncated:
            visit(value[index], schema.items, path + [index], depth + 1, result)
            set index += 1
    give nothing

public task check(value, schema):
    make issue = schema_problem(schema, [], 0, {nodes: 0, allowed: 0, text: 0}, no)
    when issue != nothing:
        give {ok: no, errors: [], schema_error: issue, truncated: no}
    make result = {errors: [], truncated: no, nodes: 0}
    visit(value, schema, [], 0, result)
    give {ok: length(result.errors) == 0 and not result.truncated, errors: result.errors, schema_error: nothing, truncated: result.truncated}

~ Bind callable values so caller-defined type constructors cannot preempt these tasks.
private make field = field
private make segment = segment
private make problem = problem
private make finite_number = finite_number
private make bound = bound
private make matches_kind = matches_kind
private make schema_problem = schema_problem
private make error = error
private make visit = visit
public make check = check
