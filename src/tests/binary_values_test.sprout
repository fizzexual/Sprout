test "binary buffers preserve embedded NUL and arbitrary bytes":
    make b: bytes = bytes([0, 128, 255, 65])
    expect kind_of(b) == "bytes"
    expect length(b) == 4
    expect bytes_hex(b) == "0080ff41"
    expect bytes_list(b) == [0, 128, 255, 65]
    expect b[0] == 0
    expect b[-1] == 65
    expect bytes_hex(b[1:3]) == "80ff"
    expect length(b[100:200]) == 0
    expect bytes_from_hex("0080FF41") == b
    expect b + bytes([66]) == bytes([0, 128, 255, 65, 66])
    expect json_decode(json_encode(b)) == b

test "UTF-8 conversion is explicit and validated":
    expect bytes_text(bytes("hello 🌱")) == "hello 🌱"
    expect error "data":
        show bytes_text(bytes([0]))
    expect error "data":
        show bytes_text(bytes_from_hex("c080"))
    expect error "data":
        show bytes_text(bytes_from_hex("eda080"))
    expect error "data":
        show bytes_from_hex("abc")
    expect error "type":
        show bytes([256])

test "GC keeps binary data inside nested collections alive":
    make containers = [{payload: bytes([0, 255])}]
    repeat 100 times:
        make garbage = bytes([0, 1, 2])
    expect bytes_hex(containers[0]["payload"]) == "00ff"
