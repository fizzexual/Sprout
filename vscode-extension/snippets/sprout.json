{
  "Window app": {
    "prefix": "window",
    "body": ["window(\"${1:My App}\")", "label(\"${2:msg}\", \"${3:Hello!}\")", "button(\"${4:Click}\", \"${5:onClick}\")"],
    "description": "A GUI window with a label and a button"
  },
  "Server app": {
    "prefix": "server",
    "body": ["server(\"${1:My Site}\")", "label(\"${2:msg}\", \"${3:Welcome!}\")"],
    "description": "A website app"
  },
  "Task": {
    "prefix": "task",
    "body": ["task ${1:name}(${2}):", "\t${0}"],
    "description": "Define a task"
  },
  "When / otherwise": {
    "prefix": "when",
    "body": ["when ${1:condition}:", "\t${2}", "otherwise:", "\t${0}"],
    "description": "A condition"
  },
  "Repeat while": {
    "prefix": "repeatwhile",
    "body": ["repeat while ${1:condition}:", "\t${0}"],
    "description": "Loop while a condition holds"
  },
  "Repeat N times": {
    "prefix": "repeat",
    "body": ["repeat ${1:3} times:", "\t${0}"],
    "description": "Loop a fixed number of times"
  },
  "Make variable": {
    "prefix": "make",
    "body": ["make ${1:name} = ${0}"],
    "description": "Create a variable"
  },
  "Task with a default input": {
    "prefix": "taskdefault",
    "body": ["task ${1:greeting}(name, punctuation = \"!\"):", "\tgive \"Hello, \" + name + punctuation", "", "show ${1:greeting}(punctuation: \"?\", name: \"${2:Ada}\")", "${0}"],
    "description": "Define a user task with a default and call it using named inputs"
  },
  "Multiline text": {
    "prefix": "multiline",
    "body": ["make ${1:template} = \"\"\"${2:First line}", "${3:Second line}", "\"\"\"", "${0}"],
    "description": "Plain multiline text; whitespace is preserved"
  },
  "Explicit native call": {
    "prefix": "intrinsic",
    "body": ["builtin::${1:length}(${2:value})${0}"],
    "description": "Call a native built-in directly; positional inputs and existing permissions apply"
  },
  "Plan a workflow": {
    "prefix": "workflowplan",
    "body": ["use workflow", "make jobs = [{id: \"${1:report}\", argv: [\"${2:tool}\"]}]", "make plan = workflow.plan(jobs)", "show plan.layers", "${0}"],
    "description": "Validate a command DAG and view dependency layers without running commands"
  },
  "Validate explicit input": {
    "prefix": "validatecheck",
    "body": [
      "use \"${1:lib/validate.sprout}\"",
      "make ${2:schema} = {kind: \"map\", fields: {${3:name}: {kind: \"text\", min_length: 1, max_length: 80}}}",
      "make ${4:input} = {${3}: \"${5:Ada}\"}",
      "make ${6:checked} = validate.check(${4}, ${2})",
      "when not ${6}.ok:",
      "\tfail \"Input validation failed.\"",
      "${0}"
    ],
    "description": "Validate an explicit plain input and schema; reject without logging input or field paths"
  },
  "Resolve explicit configuration layers": {
    "prefix": "configresolve",
    "body": [
      "use \"${1:lib/config.sprout}\"",
      "make ${2:schema} = {kind: \"map\", fields: {mode: {kind: \"text\", allowed: [\"preview\", \"apply\"]}}}",
      "make ${3:defaults} = {mode: \"preview\"}",
      "make ${4:layers} = [{name: \"example-layer\", values: {mode: \"apply\"}}]",
      "make ${5:overrides} = {}",
      "make ${6:resolved} = config.resolve(${3}, ${2}, ${4}, ${5})",
      "when not ${6}.ok:",
      "\tfail \"Configuration validation failed.\"",
      "make ${7:settings} = ${6}.values",
      "${0}"
    ],
    "description": "Resolve explicit in-memory defaults, named layers and overrides; no ambient file or environment reads"
  },
  "Parse an explicit UTC timestamp": {
    "prefix": "utcparse",
    "body": [
      "use \"${1:lib/utc.sprout}\"",
      "make ${2:timestamp} = \"${3:1970-01-01T00:00:00Z}\"",
      "make ${4:parsed} = utc.parse(${2})",
      "when not ${4}.ok:",
      "\tfail \"Timestamp input is invalid.\"",
      "make ${5:instant} = ${4}.instant",
      "${0}"
    ],
    "description": "Parse supplied timestamp text into exact seconds/nanoseconds; no clock or timezone lookup"
  },
  "Format an exact UTC instant": {
    "prefix": "utcformat",
    "body": [
      "use \"${1:lib/utc.sprout}\"",
      "make ${2:instant} = {seconds: builtin::integer(\"${3:0}\"), nanoseconds: builtin::integer(\"${4:0}\")}",
      "make ${5:formatted} = utc.format(${2})",
      "when not ${5}.ok:",
      "\tfail \"Timestamp instant is invalid.\"",
      "make ${6:timestamp} = ${5}.text",
      "${0}"
    ],
    "description": "Format explicit exact integer seconds/nanoseconds into canonical UTC text; no sampled clock"
  }
}
